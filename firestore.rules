rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'dannnymuasa@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly([
          'name', 'category', 'price', 'desc', 'image', 'imagePath', 'icon', 'inStock', 'featured', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'category', 'price', 'desc', 'image', 'imagePath', 'icon', 'inStock', 'featured', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.category in [
          'Small kitchen appliances', 'Cooking', 'Fridges and laundry', 'Home care'
        ]
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.desc is string
        && request.resource.data.desc.size() > 0
        && request.resource.data.desc.size() <= 500
        && request.resource.data.image is string
        && request.resource.data.imagePath is string
        && request.resource.data.icon is string
        && ((request.resource.data.imagePath == '' && request.resource.data.image == '')
          || (request.resource.data.imagePath.matches('products/' + request.auth.uid + '/.*')
            && request.resource.data.image.size() > 0))
        && request.resource.data.inStock is bool
        && request.resource.data.featured is bool
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inStock'])
        && request.resource.data.inStock is bool;
      allow delete: if isOwner();
    }

    match /settings/{settingId} {
      allow read: if settingId == 'catalog';
      allow create: if settingId == 'catalog'
        && isOwner()
        && request.resource.data.keys().hasOnly(['initialized', 'createdAt'])
        && request.resource.data.initialized == true
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
